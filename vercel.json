{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev:client",
  "installCommand": "npm run install:all",
  "framework": "vite",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "functions": {
    "api/**/*.js": { "maxDuration": 30 }
  }
}